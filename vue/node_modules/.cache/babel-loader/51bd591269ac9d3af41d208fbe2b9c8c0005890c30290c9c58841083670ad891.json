{"ast":null,"code":"export default {\n  name: \"ReferralRecord\",\n  data() {\n    return {\n      tableData: [],\n      // 所有的数据\n      pageNum: 1,\n      // 当前的页码\n      pageSize: 10,\n      // 每页显示的个数\n      total: 0,\n      status: null,\n      formVisible: false,\n      form: {\n        out_hospital: '',\n        in_hospital: '',\n        out_doctor: '',\n        in_doctor: '',\n        out_time: '',\n        in_time: '',\n        why: '',\n        result: ''\n      },\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n        out_hospital: [{\n          required: true,\n          message: '请输入转出医院',\n          trigger: 'blur'\n        }],\n        in_hospital: [{\n          required: true,\n          message: '请输入转入医院',\n          trigger: 'blur'\n        }],\n        out_doctor: [{\n          required: true,\n          message: '请输入转出医生',\n          trigger: 'blur'\n        }],\n        in_doctor: [{\n          required: true,\n          message: '请输入转入医生',\n          trigger: 'blur'\n        }],\n        out_time: [{\n          required: true,\n          message: '请输入转出时间',\n          trigger: 'blur'\n        }],\n        in_time: [{\n          required: true,\n          message: '请输入转入时间',\n          trigger: 'blur'\n        }],\n        why: [{\n          required: true,\n          message: '请输入转诊原因',\n          trigger: 'blur'\n        }],\n        result: [{\n          required: true,\n          message: '请输入结果',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    ok(row) {\n      return row.inDoctorId === this.user.id && this.user.role === \"DOCTOR\";\n    },\n    update(row) {\n      let form = {\n        id: row.id,\n        result: \"接收\"\n      };\n      this.$request.put('/referal/update', form).then(res => {\n        if (res.code === '200') {\n          // 表示成功保存\n          this.$message.success('成功接收');\n          this.load(1);\n          this.record(row);\n        } else {\n          this.$message.error(res.msg); // 弹出错误的信息\n        }\n      });\n    },\n    record(row) {\n      let data = {\n        userId: row.userId,\n        doctorId: row.inDoctorId,\n        hospitalId: this.user.hospitalId\n      };\n      this.$request.post('/record/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('数据同步成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    del(id) {\n      this.$confirm('您确定取消挂号吗？这个医生不好挂哦！', '灵魂拷问', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.delete('/referralRecord/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    save() {\n      this.$request.post('/referralRecord/add', this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success('保存成功');\n          this.load(1);\n          this.formVisible = false;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleAdd() {\n      this.form = {\n        out_hospital: '',\n        in_hospital: '',\n        out_doctor: '',\n        in_doctor: '',\n        out_time: '',\n        in_time: '',\n        why: '',\n        result: ''\n      };\n      this.formVisible = true;\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/referal/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.status = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","status","formVisible","form","out_hospital","in_hospital","out_doctor","in_doctor","out_time","in_time","why","result","user","JSON","parse","localStorage","getItem","rules","required","message","trigger","created","load","methods","ok","row","inDoctorId","id","role","update","$request","put","then","res","code","$message","success","record","error","msg","userId","doctorId","hospitalId","post","del","$confirm","type","response","delete","catch","save","handleAdd","get","params","list","reset","handleCurrentChange"],"sources":["src/views/records/ReferralRecord.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"search\">\n      <el-input placeholder=\"请输入转诊记录id\" style=\"width: 200px\" v-model=\"status\"></el-input>\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n    </div>\n<!--    <div class=\"operation\">-->\n<!--      <el-button type=\"primary\" plain @click=\"handleAdd\">新增</el-button>-->\n<!--    </div>-->\n    <div class=\"table\">\n      <el-table :data=\"tableData\" stripe>\n        <el-table-column prop=\"userId\" label=\"id\" width=\"80\" align=\"center\" sortable></el-table-column>\n        <el-table-column prop=\"outHospitalName\" label=\"转出医院\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"inHospitalName\" label=\"转入医院\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"outDoctorName\" label=\"转出医生\"></el-table-column>\n        <el-table-column prop=\"inDoctorName\" label=\"转入医生\"></el-table-column>\n        <el-table-column prop=\"outTime\" label=\"转出时间\" ></el-table-column>\n        <el-table-column prop=\"inTime\" label=\"转入时间\"></el-table-column>\n        <el-table-column prop=\"why\" label=\"转诊原因\"></el-table-column>\n        <el-table-column prop=\"result\" label=\"结果\"></el-table-column>\n\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n          <template v-slot=\"scope\">\n            <el-button plain type=\"danger\" size=\"mini\" v-if=\"ok(scope.row)\" @click=\"update(scope.row)\">接收</el-button>\n            <el-button plain type=\"danger\" size=\"mini\" v-if=\"ok(scope.row)\" @click=\"update(scope.row)\">拒收</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div class=\"pagination\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n\n    <el-dialog title=\"转诊记录添加\" :visible.sync=\"formVisible\" width=\"60%\" :close-on-click-modal=\"false\" destroy-on-close @close=\"cancel\">\n      <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\" :rules=\"rules\" ref=\"formRef\">\n        <el-form-item prop=\"out_hospital\" label=\"转出医院\">\n          <el-input v-model=\"form.outHospitalName\" autocomplete=\"off\" placeholder=\"请输入转出医院\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"in_hospital\" label=\"转入医院\">\n          <el-input v-model=\"form.inHospitalName\" autocomplete=\"off\" placeholder=\"请输入转入医院\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"out_doctor\" label=\"转出医生\">\n          <el-input v-model=\"form.outDoctorName\" autocomplete=\"off\" placeholder=\"请输入转出医生\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"in_doctor\" label=\"转入医生\">\n          <el-input v-model=\"form.inDoctorName\" autocomplete=\"off\" placeholder=\"请输入转入医生\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"out_time\" label=\"转出时间\">\n          <el-input v-model=\"form.outTime\" autocomplete=\"off\" placeholder=\"请输入转出时间\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"in_time\" label=\"转入时间\">\n          <el-input v-model=\"form.inTime\" autocomplete=\"off\" placeholder=\"请输入转入时间\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"why\" label=\"转诊原因\">\n          <el-input v-model=\"form.why\" autocomplete=\"off\" placeholder=\"请输入转诊原因\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"result\" label=\"结果\">\n          <el-input v-model=\"form.result\" autocomplete=\"off\" placeholder=\"请输入结果\"></el-input>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"formVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"save\">确定</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ReferralRecord\",\n  data() {\n    return {\n      tableData: [],  // 所有的数据\n      pageNum: 1,   // 当前的页码\n      pageSize: 10,  // 每页显示的个数\n      total: 0,\n      status: null,\n      formVisible: false,\n      form: {\n        out_hospital: '',\n        in_hospital: '',\n        out_doctor: '',\n        in_doctor: '',\n        out_time: '',\n        in_time: '',\n        why: '',\n        result: ''\n      },\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n        out_hospital: [\n          { required: true, message: '请输入转出医院', trigger: 'blur' }\n        ],\n        in_hospital: [\n          { required: true, message: '请输入转入医院', trigger: 'blur' }\n        ],\n        out_doctor: [\n          { required: true, message: '请输入转出医生', trigger: 'blur' }\n        ],\n        in_doctor: [\n          { required: true, message: '请输入转入医生', trigger: 'blur' }\n        ],\n        out_time: [\n          { required: true, message: '请输入转出时间', trigger: 'blur' }\n        ],\n        in_time: [\n          { required: true, message: '请输入转入时间', trigger: 'blur' }\n        ],\n        why: [\n          { required: true, message: '请输入转诊原因', trigger: 'blur' }\n        ],\n        result: [\n          { required: true, message: '请输入结果', trigger: 'blur' }\n        ]\n      }\n    }\n  },\n  created() {\n    this.load(1)\n  },\n  methods: {\n    ok(row){\n      return row.inDoctorId===this.user.id&& this.user.role===\"DOCTOR\"\n    },\n    update(row){\n      let form={\n        id:row.id,\n        result:\"接收\"\n      }\n      this.$request.put('/referal/update', form).then(res => {\n        if (res.code === '200') {  // 表示成功保存\n          this.$message.success('成功接收')\n          this.load(1)\n          this.record(row)\n        } else {\n          this.$message.error(res.msg)  // 弹出错误的信息\n        }\n      })\n    },\n    record(row) {\n      let data = {\n        userId: row.userId,\n        doctorId: row.inDoctorId,\n        hospitalId: this.user.hospitalId\n      }\n      this.$request.post('/record/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('数据同步成功')\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    del(id) {\n      this.$confirm('您确定取消挂号吗？这个医生不好挂哦！', '灵魂拷问', {type: \"warning\"}).then(response => {\n        this.$request.delete('/referralRecord/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功')\n            this.load(1)\n          } else {\n            this.$message.error(res.msg)\n          }\n        })\n      }).catch(() => {})\n    },\n    save() {\n      this.$request.post('/referralRecord/add', this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success('保存成功')\n          this.load(1)\n          this.formVisible = false\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    handleAdd() {\n      this.form = {\n        out_hospital: '',\n        in_hospital: '',\n        out_doctor: '',\n        in_doctor: '',\n        out_time: '',\n        in_time: '',\n        why: '',\n        result: ''\n      }\n      this.formVisible = true\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum\n      this.$request.get('/referal/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status,\n        }\n      }).then(res => {\n        this.tableData = res.data?.list\n        this.total = res.data?.total\n      })\n    },\n    reset() {\n      this.status = null\n      this.load(1)\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum)\n    },\n  }\n}\n</script>\n\n<style scoped>\n\n</style>\n"],"mappings":"AA+EA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MAAA;MACAC,OAAA;MAAA;MACAC,QAAA;MAAA;MACAC,KAAA;MACAC,MAAA;MACAC,WAAA;MACAC,IAAA;QACAC,YAAA;QACAC,WAAA;QACAC,UAAA;QACAC,SAAA;QACAC,QAAA;QACAC,OAAA;QACAC,GAAA;QACAC,MAAA;MACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,KAAA;QACAb,YAAA,GACA;UAAAc,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAf,WAAA,GACA;UAAAa,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAd,UAAA,GACA;UAAAY,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAb,SAAA,GACA;UAAAW,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAZ,QAAA,GACA;UAAAU,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAX,OAAA,GACA;UAAAS,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAV,GAAA,GACA;UAAAQ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAT,MAAA,GACA;UAAAO,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,GAAAC,GAAA;MACA,OAAAA,GAAA,CAAAC,UAAA,UAAAd,IAAA,CAAAe,EAAA,SAAAf,IAAA,CAAAgB,IAAA;IACA;IACAC,OAAAJ,GAAA;MACA,IAAAtB,IAAA;QACAwB,EAAA,EAAAF,GAAA,CAAAE,EAAA;QACAhB,MAAA;MACA;MACA,KAAAmB,QAAA,CAAAC,GAAA,oBAAA5B,IAAA,EAAA6B,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAd,IAAA;UACA,KAAAe,MAAA,CAAAZ,GAAA;QACA;UACA,KAAAU,QAAA,CAAAG,KAAA,CAAAL,GAAA,CAAAM,GAAA;QACA;MACA;IACA;IACAF,OAAAZ,GA