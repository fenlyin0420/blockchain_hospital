{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Manager\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}')\n    };\n  },\n  created() {\n    if (!this.user.id) {\n      this.$router.push('/login');\n    }\n  },\n  methods: {\n    updateUser() {\n      this.user = JSON.parse(localStorage.getItem('xm-user') || '{}'); // 重新获取下用户的最新信息\n    },\n    goToPerson() {\n      if (this.user.role === 'ADMIN') {\n        this.$router.push('/adminPerson');\n      }\n      if (this.user.role === 'DOCTOR') {\n        this.$router.push('/doctorPerson');\n      }\n      if (this.user.role === 'USER') {\n        this.$router.push('/userPerson');\n      }\n    },\n    PersonalInformation() {\n      this.$router.push(\"PersonalInformation\");\n    },\n    logout() {\n      localStorage.removeItem('xm-user');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","created","id","$router","push","methods","updateUser","goToPerson","role","PersonalInformation","logout","removeItem"],"sources":["src/views/Manager.vue"],"sourcesContent":["<template>\r\n  <div class=\"manager-container\">\r\n    <!--  头部  -->\r\n    <div class=\"manager-header\">\r\n      <div class=\"manager-header-left\">\r\n        <img src=\"@/assets/imgs/logo.png\" />\r\n        <div class=\"title\">智能转诊系统</div>\r\n      </div>\r\n\r\n      <!-- 面包屑导航栏 -->\r\n      <div class=\"manager-header-center\">\r\n        <el-breadcrumb separator-class=\"el-icon-arrow-right\">\r\n          <el-breadcrumb-item :to=\"{ path: '/' }\">首页</el-breadcrumb-item>\r\n          <el-breadcrumb-item :to=\"{ path: $route.path }\">{{ $route.meta.name }}</el-breadcrumb-item>\r\n        </el-breadcrumb>\r\n      </div>\r\n\r\n      <div class=\"manager-header-right\">\r\n        <el-dropdown placement=\"bottom\">\r\n          <div class=\"avatar\">\r\n            <img :src=\"user.avatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" />\r\n            <div style=\"color: #666666\">{{ user.name ||  '管理员' }}</div>\r\n          </div>\r\n          <el-dropdown-menu slot=\"dropdown\">\r\n            <el-dropdown-item @click.native=\"PersonalInformation\">密钥管理</el-dropdown-item>\r\n            <el-dropdown-item @click.native=\"goToPerson\">个人信息</el-dropdown-item>\r\n            <el-dropdown-item @click.native=\"$router.push('/password')\">修改密码</el-dropdown-item>\r\n            <el-dropdown-item @click.native=\"logout\">退出登录</el-dropdown-item>\r\n          </el-dropdown-menu>\r\n        </el-dropdown>\r\n      </div>\r\n    </div>\r\n\r\n    <!--  主体  -->\r\n    <div class=\"manager-main\">\r\n      <!--  侧边栏  -->\r\n      <div class=\"manager-main-left\">\r\n        <el-menu :unique-opened=\"true\" router style=\"border: none\" :default-active=\"$route.path\">\r\n          <!--default-openeds=\"['info','powerDoctor', 'reserve', 'user','powerUser']\"-->\r\n<!--去除掉首页         -->\r\n          <el-menu-item index=\"/home\">\r\n            <i class=\"el-icon-s-home\"></i>\r\n            <span slot=\"title\" style=\"font-size: 20px;\">系统首页</span>\r\n          </el-menu-item>\r\n\r\n          <el-submenu index=\"info\" v-if=\"user.role !== 'USER'\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i>\r\n              <span>信息管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/notice\" v-if=\"user.role === 'ADMIN'\">公告信息</el-menu-item>\r\n            <el-menu-item index=\"/department\" v-if=\"user.role === 'ADMIN'\">科室信息</el-menu-item>\r\n            <el-menu-item index=\"/plan\">医生排班</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"reserve\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>预约就诊</span>\r\n            </template>\r\n            <el-menu-item index=\"/doctorCard\" v-if=\"user.role!=='DOCTOR'\">预约挂号</el-menu-item>\r\n            <el-menu-item index=\"/reserve\">患者挂号</el-menu-item>\r\n            <el-menu-item index=\"/record\">我的就诊</el-menu-item>\r\n            <el-menu-item index=\"/registration\" v-if=\"user.role !== 'DOCTOR' && user.role !=='USER'\">住院登记</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"powerDoctor\" v-if=\"user.role === 'DOCTOR'\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>档案管理</span>\r\n            </template>\r\n<!--            <el-menu-item index=\"/SearchFiles\">档案检索</el-menu-item>-->\r\n<!--            <el-menu-item index=\"/AddFiles\">新建档案</el-menu-item>-->\r\n            <el-menu-item index=\"/caseList\">病历列表</el-menu-item>\r\n            <el-menu-item index=\"/case\">新建病历</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"user\" v-if=\"user.role === 'ADMIN'\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>用户管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/admin\">管理员信息</el-menu-item>\r\n            <el-menu-item index=\"/doctor\">医生信息</el-menu-item>\r\n            <el-menu-item index=\"/user\">患者信息</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"powerUser\" v-if=\"user.role === 'USER'\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>档案管理</span>\r\n            </template>\r\n<!--            <el-menu-item index=\"/MyFiles\">我的档案</el-menu-item>-->\r\n<!--            <el-menu-item index=\"/Power\">权限管理</el-menu-item>-->\r\n            <el-menu-item index=\"/caseList\">病历列表</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"record\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>转诊管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/referralRecord\">转诊信息</el-menu-item>\r\n            <el-menu-item index=\"/referralApplication\" v-if=\"user.role !== 'USER'\">转诊申请</el-menu-item>\r\n          </el-submenu>\r\n\r\n          <el-submenu index=\"information\" v-if=\"user.role === 'ADMIN'\">\r\n            <template slot=\"title\">\r\n              <i class=\"el-icon-menu\"></i><span>信息管理</span>\r\n            </template>\r\n            <el-menu-item index=\"/hospital\" >医院信息</el-menu-item>\r\n            <el-menu-item index=\"/drug\" >药品信息</el-menu-item>\r\n          </el-submenu>\r\n        </el-menu>\r\n      </div>\r\n\r\n      <!--  数据表格  -->\r\n      <div class=\"manager-main-right\">\r\n        <router-view @update:user=\"updateUser\" />\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Manager\",\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n    }\r\n  },\r\n  created() {\r\n    if (!this.user.id) {\r\n      this.$router.push('/login')\r\n    }\r\n  },\r\n  methods: {\r\n    updateUser() {\r\n      this.user = JSON.parse(localStorage.getItem('xm-user') || '{}')   // 重新获取下用户的最新信息\r\n    },\r\n    goToPerson() {\r\n      if (this.user.role === 'ADMIN') {\r\n        this.$router.push('/adminPerson')\r\n      }\r\n      if (this.user.role === 'DOCTOR') {\r\n        this.$router.push('/doctorPerson')\r\n      }\r\n      if (this.user.role === 'USER') {\r\n        this.$router.push('/userPerson')\r\n      }\r\n    },\r\n    PersonalInformation(){\r\n      this.$router.push(\"PersonalInformation\")\r\n    },\r\n    logout() {\r\n      localStorage.removeItem('xm-user')\r\n      this.$router.push('/login')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import \"@/assets/css/manager.css\";\r\n.el-icon-menu span {\r\n  font-size: 30px;\r\n}\r\n</style>"],"mappings":";AAyHA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,UAAAL,IAAA,CAAAM,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAA;MACA,KAAAV,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;IACAO,WAAA;MACA,SAAAX,IAAA,CAAAY,IAAA;QACA,KAAAL,OAAA,CAAAC,IAAA;MACA;MACA,SAAAR,IAAA,CAAAY,IAAA;QACA,KAAAL,OAAA,CAAAC,IAAA;MACA;MACA,SAAAR,IAAA,CAAAY,IAAA;QACA,KAAAL,OAAA,CAAAC,IAAA;MACA;IACA;IACAK,oBAAA;MACA,KAAAN,OAAA,CAAAC,IAAA;IACA;IACAM,OAAA;MACAX,YAAA,CAAAY,UAAA;MACA,KAAAR,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}