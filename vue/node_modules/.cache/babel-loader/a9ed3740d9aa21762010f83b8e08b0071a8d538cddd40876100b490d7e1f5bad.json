{"ast":null,"code":"export default {\n  name: \"ReferralApplication\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      name: \"\",\n      transferOutHospital: '',\n      transferOutDoctor: '',\n      transferOutTime: null,\n      transferInHospital: '',\n      transferInDoctor: '',\n      transferInTime: null,\n      transferReason: '',\n      caseInfo: [],\n      tableData: [],\n      infByHospital: [],\n      infByDoctor: [],\n      information: {}\n    };\n  },\n  created() {\n    this.loadByUser();\n    this.loadByHospital();\n    //this.loadByDoctor()\n  },\n  methods: {\n    loadByUser() {\n      this.$request.get('/record/selectAll', {\n        params: {\n          doctorId: this.user.id\n        }\n      }).then(res => {\n        this.$message.success(\"成功\");\n        this.tableData = res.data;\n      });\n    },\n    loadByDoctor() {\n      let id = this.transferInHospital;\n      this.$request.get('/doctor/selectByH/' + id).then(res => {\n        if (res.code === '200') {\n          this.infByDoctor = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    loadByHospital() {\n      this.$request.get('/hospital/selectAll').then(res => {\n        this.infByHospital = res.data;\n      });\n    },\n    confirmTransfer() {\n      // Add logic to handle the transfer confirmation here\n      this.information.userId = this.caseInfo.userId;\n      this.information.outHospitalId = this.caseInfo.hospitalId;\n      this.information.outDoctorId = this.caseInfo.doctorId;\n      this.information.inHospitalId = this.transferInHospital;\n      this.information.inDoctorId = this.transferInDoctor;\n      this.information.why = this.transferReason;\n      this.information.result = \"待接收\";\n      let data = JSON.parse(JSON.stringify(this.information));\n      this.$request.post('/referal/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","transferOutHospital","transferOutDoctor","transferOutTime","transferInHospital","transferInDoctor","transferInTime","transferReason","caseInfo","tableData","infByHospital","infByDoctor","information","created","loadByUser","loadByHospital","methods","$request","get","params","doctorId","id","then","res","$message","success","loadByDoctor","code","error","msg","confirmTransfer","userId","outHospitalId","hospitalId","outDoctorId","inHospitalId","inDoctorId","why","result","stringify","post"],"sources":["src/views/records/ReferralApplication.vue"],"sourcesContent":["<template>\n  <div>\n    <rl-row class=\"info-row\">\n      <span class=\"field-label\">选择:</span>\n      <el-select v-model=\"caseInfo\" placeholder=\"请选择医院\" >\n        <div v-for=\"item in tableData\">\n          <el-option :label=\"item.userName+'-'+item.hospitalName\" :value=\"item\"></el-option>\n        </div>\n      </el-select>\n        <span style=\"margin-left: 50px\">姓名：</span>\n      <span style=\"margin-left: 50px\">{{caseInfo.userName}}</span>\n\n    </rl-row>\n    <div class=\"form-container\">\n      <div class=\"left-form\">\n        <div class=\"label\">转出信息</div>\n        <el-input placeholder=\"转出医院\" v-model=\"caseInfo.hospitalName\" :readonly=\"true\" clearable></el-input>\n        <el-input placeholder=\"转出医生\" v-model=\"caseInfo.doctorName\" :readonly=\"true\" clearable></el-input>\n<!--        <el-date-picker placeholder=\"转出时间\" v-model=\"transferOutTime\" clearable style=\"width: 100%;\"></el-date-picker>-->\n      </div>\n\n      <div class=\"right-form\">\n        <div class=\"label\">转入信息</div>\n<!--        <el-input placeholder=\"转入医院\" v-model=\"transferInHospital\" clearable></el-input>-->\n        <el-select v-model=\"transferInHospital\" placeholder=\"请选择医院\" @change=\"loadByDoctor()\" style=\"width: 500px;margin-bottom: 20px\">\n          <div v-for=\"item in infByHospital\">\n            <el-option :label=\"item.hospitalName\" :value=\"item.id\"></el-option>\n          </div>\n        </el-select>\n<!--        <el-input placeholder=\"转入医生\" v-model=\"transferInDoctor\" clearable></el-input>-->\n        <el-select v-model=\"transferInDoctor\" placeholder=\"请选择医生\" style=\"width: 500px\">\n          <div v-for=\"item in infByDoctor\">\n            <el-option :label=\"item.name\" :value=\"item.id\"></el-option>\n          </div>\n        </el-select>\n<!--        <el-date-picker placeholder=\"转入时间\" v-model=\"transferInTime\" clearable style=\"width: 100%;\"></el-date-picker>-->\n      </div>\n    </div>\n\n    <el-input type=\"textarea\" placeholder=\"转院理由\" v-model=\"transferReason\" clearable :rows=\"4\"></el-input>\n\n    <el-button type=\"primary\" style=\"margin-top: 10px;\" @click=\"confirmTransfer\">确定</el-button>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ReferralApplication\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      name:\"\",\n      transferOutHospital: '',\n      transferOutDoctor: '',\n      transferOutTime: null,\n      transferInHospital: '',\n      transferInDoctor: '',\n      transferInTime: null,\n      transferReason: '',\n      caseInfo:[],\n      tableData:[],\n      infByHospital:[],\n      infByDoctor:[],\n      information:{}\n    }\n  },\n  created() {\n    this.loadByUser()\n    this.loadByHospital()\n    //this.loadByDoctor()\n  },\n  methods: {\n    loadByUser(){\n      this.$request.get('/record/selectAll',{\n        params:{\n          doctorId:this.user.id\n        }\n      }).then(res => {\n        this.$message.success(\"成功\")\n        this.tableData = res.data\n      })\n    },\n    loadByDoctor() {\n      let id=this.transferInHospital\n      this.$request.get('/doctor/selectByH/'+id).then(res => {\n        if (res.code === '200') {\n          this.infByDoctor = res.data\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    loadByHospital(){\n      this.$request.get('/hospital/selectAll').then(res=>{\n        this.infByHospital=res.data\n      })\n    },\n    confirmTransfer() {\n      // Add logic to handle the transfer confirmation here\n      this.information.userId=this.caseInfo.userId\n      this.information.outHospitalId=this.caseInfo.hospitalId\n      this.information.outDoctorId=this.caseInfo.doctorId\n      this.information.inHospitalId=this.transferInHospital\n      this.information.inDoctorId=this.transferInDoctor\n      this.information.why=this.transferReason\n      this.information.result=\"待接收\"\n      let data = JSON.parse(JSON.stringify(this.information))\n      this.$request.post('/referal/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('成功')\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.form-container {\n  display: flex;\n  justify-content: space-between;\n}\n\n.left-form, .right-form {\n  flex: 1;\n  margin-right: 20px;\n}\n\n.right-form {\n  margin-right: 0;\n}\n\n.label {\n  margin-bottom: 10px;\n  font-weight: bold;\n}\n\n.el-input, .el-date-picker {\n  margin-bottom: 20px;\n}\n\n.el-textarea {\n  margin-top: 20px;\n}\n</style>\n"],"mappings":"AA8CA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAN,IAAA;MACAO,mBAAA;MACAC,iBAAA;MACAC,eAAA;MACAC,kBAAA;MACAC,gBAAA;MACAC,cAAA;MACAC,cAAA;MACAC,QAAA;MACAC,SAAA;MACAC,aAAA;MACAC,WAAA;MACAC,WAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,UAAA;IACA,KAAAC,cAAA;IACA;EACA;EACAC,OAAA;IACAF,WAAA;MACA,KAAAG,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAC,QAAA,OAAAxB,IAAA,CAAAyB;QACA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA,KAAAhB,SAAA,GAAAc,GAAA,CAAA5B,IAAA;MACA;IACA;IACA+B,aAAA;MACA,IAAAL,EAAA,QAAAjB,kBAAA;MACA,KAAAa,QAAA,CAAAC,GAAA,wBAAAG,