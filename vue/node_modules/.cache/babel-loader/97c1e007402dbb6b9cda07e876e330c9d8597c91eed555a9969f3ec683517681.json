{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      receivedData: [],\n      drug: {},\n      params: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      pubs: {}\n    };\n  },\n  created() {\n    this.receivedData = this.$route.params.inform;\n    this.load();\n  },\n  methods: {\n    load() {\n      if (this.receivedData.length === 0) {\n        this.$router.push(\"/caseList\");\n      }\n      const medicationString = this.receivedData.drug;\n\n      // 拆分字符串为每一行\n      const lines = medicationString.split('\\n');\n\n      // 将每一行拆分为药物信息对象\n      const medications = lines.map(line => {\n        const parts = line.split(' ');\n        return {\n          name: parts[0],\n          dose: parts[1],\n          frequency: parts[2]\n        };\n      });\n      this.drug = medications;\n      console.log(this.drug);\n      console.log(this.receivedData);\n      if (this.receivedData.signPubKey !== null || this.receivedData.signPubKey !== \"\") {\n        const s = this.receivedData.signPubKey.split(\",\");\n        const ss = s.map(line => {\n          const parts = line.split(':');\n          return {\n            name: parts[0],\n            key: parts[1]\n          };\n        });\n        this.pubs = ss;\n      }\n      console.log(this.pubs);\n    },\n    sign() {\n      this.params.role = this.user.role;\n      this.params.id = this.receivedData.id;\n      this.params.name = this.receivedData.name;\n      this.$request.post('/keys/sign', this.receivedData).then(res => {\n        if (res.code === '200') {\n          this.$message.success('成功');\n          this.receivedData.signData = res.data.signData;\n          this.receivedData.signKey = res.data.signKey;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    verifySign() {\n      this.params.role = this.user.role;\n      this.params.id = this.receivedData.id;\n      this.params.name = this.receivedData.name;\n      this.params.signKey = this.receivedData.signKey;\n      this.$request.post('/keys/verifySign', this.receivedData).then(res => {\n        if (res.code === '200') {\n          this.$message.success('成功');\n          this.receivedData.signResult = res.data.message;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","receivedData","drug","params","user","JSON","parse","localStorage","getItem","pubs","created","$route","inform","load","methods","length","$router","push","medicationString","lines","split","medications","map","line","parts","name","dose","frequency","console","log","signPubKey","s","ss","key","sign","role","id","$request","post","then","res","code","$message","success","signData","signKey","error","msg","verifySign","signResult","message"],"sources":["src/views/records/CaseDetails.vue"],"sourcesContent":["<template>\r\n  <el-card class=\"case-details\">\r\n    <div class=\"header\">\r\n      <h2>病例详情</h2>\r\n    </div>\r\n    <el-row :gutter=\"20\">\r\n      <el-col :span=\"8\">\r\n        <el-form label-width=\"120px\">\r\n          <el-form-item label=\"医院名称\">\r\n            <span>{{ receivedData.hospitalName }}</span>\r\n          </el-form-item>\r\n          <el-form-item label=\"患者姓名\">\r\n            <span>{{ receivedData.name }}</span>\r\n          </el-form-item>\r\n          <el-form-item label=\"主治医生姓名\">\r\n            <span>{{ receivedData.doctorName }}</span>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-col>\r\n      <el-col :span=\"16\">\r\n        <el-form label-width=\"120px\">\r\n          <el-form-item label=\"医嘱信息\">\r\n            <el-input\r\n                type=\"textarea\"\r\n                :autosize=\"{ minRows: 4, maxRows: 4}\"\r\n                placeholder=\"请输入内容\"\r\n                v-model=\"receivedData.advice\">\r\n            </el-input>\r\n          </el-form-item>\r\n          <el-form-item label=\"药品信息\">\r\n            <el-table :data=\"drug\" style=\"width: 100%\" height=\"200\" border>\r\n              <el-table-column prop=\"name\" label=\"药品名称\"></el-table-column>\r\n              <el-table-column prop=\"dose\" label=\"数量\"></el-table-column>\r\n              <el-table-column prop=\"frequency\" label=\"用法用量\"></el-table-column>\r\n            </el-table>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <el-row :gutter=\"20\">\r\n      <el-col :span=\"8\">\r\n        <div style=\"margin: 0 0 20px 0\">\r\n\r\n          <el-row>\r\n            <el-col :span=\"10\">\r\n              <div style=\"margin: 5px 0 0 25px\">\r\n                环签名数据\r\n              </div>\r\n            </el-col>\r\n            <el-col :span=\"14\">\r\n              <div class=\"grid-content bg-purple-light\">\r\n                <el-button plain type=\"primary\" @click=\"sign()\" v-if=\"user.role==='DOCTOR'\">签名</el-button>\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n\r\n        </div>\r\n        <div class=\"grid-content bg-purple\">\r\n          <el-input\r\n              type=\"textarea\"\r\n              :autosize=\"{ minRows: 4, maxRows: 8}\"\r\n              placeholder=\"请输入内容\"\r\n              v-model=\"receivedData.signData\">\r\n          </el-input>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"8\">\r\n        <div style=\"margin: 0 0 29px 0\">\r\n\r\n          <el-row>\r\n            <el-col :span=\"10\">\r\n              <div style=\"margin: 5px 0 0 25px\">\r\n                环签名信息\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n\r\n        </div>\r\n        <div class=\"grid-content bg-purple-light\">\r\n          <el-input\r\n              type=\"textarea\"\r\n              :autosize=\"{ minRows: 4, maxRows: 8}\"\r\n              placeholder=\"请输入内容\"\r\n              v-model=\"receivedData.signKey\">\r\n          </el-input>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"8\">\r\n        <div style=\"margin: 0 0 20px 0\">\r\n          <el-row>\r\n            <el-col :span=\"10\">\r\n              <div style=\"margin: 5px 0 0 25px\">\r\n                验签结果\r\n              </div>\r\n            </el-col>\r\n            <el-col :span=\"14\">\r\n              <div class=\"grid-content bg-purple-light\">\r\n                <el-button plain type=\"primary\" @click=\"verifySign()\" v-if=\"user.role==='DOCTOR'\">验签</el-button>\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n        </div>\r\n        <div class=\"grid-content bg-purple-light\">\r\n          <el-input\r\n              type=\"textarea\"\r\n              :autosize=\"{ minRows: 4, maxRows: 8}\"\r\n              placeholder=\"请输入内容\"\r\n              v-model=\"receivedData.signResult\">\r\n          </el-input>\r\n        </div>\r\n      </el-col>\r\n    </el-row>\r\n\r\n    <div class=\"header\" style=\"margin: 20px 0\">\r\n      <h2>环公钥组成信息</h2>\r\n    </div>\r\n\r\n    <div v-if=\"pubs.length!==0\">\r\n      <el-table :data=\"pubs\" height=\"250\" border style=\"width: 100%\">\r\n        <el-table-column\r\n            prop=\"name\"\r\n            label=\"姓名\"\r\n            width=\"180\">\r\n        </el-table-column>\r\n        <el-table-column\r\n            prop=\"key\"\r\n            label=\"公钥\">\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </el-card>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      receivedData:[],\r\n      drug:{},\r\n      params:{},\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      pubs:{}\r\n    };\r\n  },\r\n  created() {\r\n    this.receivedData = this.$route.params.inform;\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n      if(this.receivedData.length===0){\r\n        this.$router.push(\"/caseList\")\r\n      }\r\n      const medicationString = this.receivedData.drug;\r\n\r\n      // 拆分字符串为每一行\r\n      const lines = medicationString.split('\\n');\r\n\r\n      // 将每一行拆分为药物信息对象\r\n      const medications = lines.map(line => {\r\n        const parts = line.split(' ');\r\n        return {\r\n          name: parts[0],\r\n          dose: parts[1],\r\n          frequency: parts[2]\r\n        };\r\n      });\r\n      this.drug=medications\r\n      console.log(this.drug)\r\n      console.log(this.receivedData)\r\n      if(this.receivedData.signPubKey!==null||this.receivedData.signPubKey!==\"\"){\r\n        const s=this.receivedData.signPubKey.split(\",\")\r\n        const ss = s.map(line => {\r\n          const parts = line.split(':');\r\n          return {\r\n            name: parts[0],\r\n            key: parts[1],\r\n          };\r\n        });\r\n        this.pubs=ss\r\n      }\r\n      console.log(this.pubs)\r\n    },\r\n    sign(){\r\n\r\n      this.params.role=this.user.role\r\n      this.params.id=this.receivedData.id\r\n      this.params.name=this.receivedData.name\r\n      this.$request.post('/keys/sign', this.receivedData).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('成功')\r\n          this.receivedData.signData=res.data.signData\r\n          this.receivedData.signKey=res.data.signKey\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    verifySign(){\r\n      this.params.role=this.user.role\r\n      this.params.id=this.receivedData.id\r\n      this.params.name=this.receivedData.name\r\n      this.params.signKey=this.receivedData.signKey\r\n      this.$request.post('/keys/verifySign', this.receivedData).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('成功')\r\n          this.receivedData.signResult=res.data.message\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.case-details {\r\n  margin: 20px;\r\n}\r\n\r\n.header {\r\n  margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":";AAuIA;EACAA,KAAA;IACA;MACAC,YAAA;MACAC,IAAA;MACAC,MAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAT,YAAA,QAAAU,MAAA,CAAAR,MAAA,CAAAS,MAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,SAAAZ,YAAA,CAAAc,MAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA;MACA,MAAAC,gBAAA,QAAAjB,YAAA,CAAAC,IAAA;;MAEA;MACA,MAAAiB,KAAA,GAAAD,gBAAA,CAAAE,KAAA;;MAEA;MACA,MAAAC,WAAA,GAAAF,KAAA,CAAAG,GAAA,CAAAC,IAAA;QACA,MAAAC,KAAA,GAAAD,IAAA,CAAAH,KAAA;QACA;UACAK,IAAA,EAAAD,KAAA;UACAE,IAAA,EAAAF,KAAA;UACAG,SAAA,EAAAH,KAAA;QACA;MACA;MACA,KAAAtB,IAAA,GAAAmB,WAAA;MACAO,OAAA,CAAAC,GAAA,MAAA3B,IAAA;MACA0B,OAAA,CAAAC,GAAA,MAAA5B,YAAA;MACA,SAAAA,YAAA,CAAA6B,UAAA,kBAAA7B,YAAA,CAAA6B,UAAA;QACA,MAAAC,CAAA,QAAA9B,YAAA,CAAA6B,UAAA,CAAAV,KAAA;QACA,MAAAY,EAAA,GAAAD,CAAA,CAAAT,GAAA,CAAAC,IAAA;UACA,MAAAC,KAAA,GAAAD,IAAA,CAAAH,KAAA;UACA;YACAK,IAAA,EAAAD,KAAA;YACAS,GAAA,EAAAT,KAAA;UACA;QACA;QACA,KAAAf,IAAA,GAAAuB,EAAA;MACA;MACAJ,OAAA,CAAAC,GAAA,MAAApB,IAAA;IACA;IACAyB,KAAA;MAEA,KAAA/B,MAAA,CAAAgC,IAAA,QAAA/B,IAAA,CAAA+B,IAAA;MACA,KAAAhC,MAAA,CAAAiC,EAAA,QAAAnC,YAAA,CAAAmC,EAAA;MACA,KAAAjC,MAAA,CAAAsB,IAAA,QAAAxB,YAAA,CAAAwB,IAAA;MACA,KAAAY,QAAA,CAAAC,IAAA,oBAAArC,YAAA,EAAAsC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAA1C,YAAA,CAAA2C,QAAA,GAAAJ,GAAA,CAAAxC,IAAA,CAAA4C,QAAA;UACA,KAAA3C,YAAA,CAAA4C,OAAA,GAAAL,GAAA,CAAAxC,IAAA,CAAA6C,OAAA;QACA;UACA,KAAAH,QAAA,CAAAI,KAAA,CAAAN,GAAA,CAAAO,GAAA;QACA;MACA;IACA;IACAC,WAAA;MACA,KAAA7C,MAAA,CAAAgC,IAAA,QAAA/B,IAAA,CAAA+B,IAAA;MACA,KAAAhC,MAAA,CAAAiC,EAAA,QAAAnC,YAAA,CAAAmC,EAAA;MACA,KAAAjC,MAAA,CAAAsB,IAAA,QAAAxB,YAAA,CAAAwB,IAAA;MACA,KAAAtB,MAAA,CAAA0C,OAAA,QAAA5C,YAAA,CAAA4C,OAAA;MACA,KAAAR,QAAA,CAAAC,IAAA,0BAAArC,YAAA,EAAAsC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAA1C,YAAA,CAAAgD,UAAA,GAAAT,GAAA,CAAAxC,IAAA,CAAAkD,OAAA;QACA;UACA,KAAAR,QAAA,CAAAI,KAAA,CAAAN,GAAA,CAAAO,