{"ast":null,"code":"export default {\n  name: \"Drug\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      status: null,\n      formVisible: false,\n      form: {\n        hospitalId: '',\n        drugNumber: '',\n        drugName: '',\n        price: ''\n      },\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n        drugNumber: [{\n          required: true,\n          message: '请输入生产批号',\n          trigger: 'blur'\n        }],\n        drugName: [{\n          required: true,\n          message: '请输入药名',\n          trigger: 'blur'\n        }],\n        price: [{\n          required: true,\n          message: '请输入价格',\n          trigger: 'blur'\n        }]\n      },\n      hospitalList: []\n    };\n  },\n  created() {\n    this.load(1);\n    this.load2();\n  },\n  methods: {\n    call(row) {\n      let reserveData = {\n        ...row,\n        status: '已叫号'\n      };\n      this.$request.put('/drug/update', reserveData).then(res => {\n        if (res.code === '200') {\n          this.$message.success('叫号成功');\n          this.load(1);\n          this.record(row);\n        }\n      });\n    },\n    record(row) {\n      let data = {\n        userId: row.userId,\n        doctorId: row.doctorId\n      };\n      this.$request.post('/record/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('数据同步成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    del(id) {\n      this.$confirm('您确定取消挂号吗？这个医生不好挂哦！', '灵魂拷问', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.delete('/drug/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    handleEdit(row) {\n      // 编辑数据\n      this.form = JSON.parse(JSON.stringify(row)); // 给form对象赋值  注意要深拷贝数据\n      this.formVisible = true; // 打开弹窗\n    },\n    save() {\n      this.$request.post('/drug/add', this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success('保存成功');\n          this.load(1);\n          this.formVisible = false;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    handleAdd() {\n      this.form = {\n        hospitalId: this.user.hospitalId,\n        drugNumber: '',\n        drugName: '',\n        price: ''\n      };\n      this.formVisible = true;\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/drug/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status,\n          hospitalId: this.user.hospitalId\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    load2() {\n      this.$request.get('/hospital/selectAll').then(res => {\n        this.hospitalList = res.data;\n      });\n    },\n    reset() {\n      this.status = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","status","formVisible","form","hospitalId","drugNumber","drugName","price","user","JSON","parse","localStorage","getItem","rules","required","message","trigger","hospitalList","created","load","load2","methods","call","row","reserveData","$request","put","then","res","code","$message","success","record","userId","doctorId","post","error","msg","del","id","$confirm","type","response","delete","catch","handleEdit","stringify","save","handleAdd","get","params","list","reset","handleCurrentChange"],"sources":["src/views/records/Drug.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"search\">\n      <el-input placeholder=\"请输入药品id\" style=\"width: 200px\" v-model=\"status\"></el-input>\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n    </div>\n    <div class=\"operation\">\n      <el-button type=\"primary\" plain @click=\"handleAdd\">新增</el-button>\n    </div>\n    <div class=\"table\">\n      <el-table :data=\"tableData\" stripe>\n        <el-table-column prop=\"id\" label=\"id\" width=\"80\" align=\"center\" sortable></el-table-column>\n        <el-table-column prop=\"hospitalName\" label=\"医院\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"drugNumber\" label=\"生产批号\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"drugName\" label=\"药名\"></el-table-column>\n        <el-table-column prop=\"price\" label=\"价格\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n          <template v-slot=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" plain @click=\"handleEdit(scope.row)\">编辑</el-button>\n            <el-button size=\"mini\" type=\"danger\" plain @click=\"del(scope.row.id)\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div class=\"pagination\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n\n    <el-dialog title=\"药品添加\" :visible.sync=\"formVisible\" width=\"60%\" :close-on-click-modal=\"false\" destroy-on-close @close=\"cancel\">\n      <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\" :rules=\"rules\" ref=\"formRef\">\n        <el-form-item prop=\"drugNumber\" label=\"生产批号\">\n          <el-input v-model=\"form.drugNumber\" autocomplete=\"off\" placeholder=\"请输入生产批号\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"drugName\" label=\"药名\">\n          <el-input v-model=\"form.drugName\" autocomplete=\"off\" placeholder=\"请输入药名\"></el-input>\n        </el-form-item>\n        <el-form-item prop=\"price\" label=\"价格\">\n          <el-input v-model=\"form.price\" autocomplete=\"off\" placeholder=\"请输入价格\"></el-input>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"formVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"save\">确定</el-button>\n      </div>\n    </el-dialog>\n\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Drug\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      status: null,\n      formVisible: false,\n      form: {\n        hospitalId: '',\n        drugNumber: '',\n        drugName: '',\n        price: ''\n      },\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {\n        drugNumber: [\n          { required: true, message: '请输入生产批号', trigger: 'blur' }\n        ],\n        drugName: [\n          { required: true, message: '请输入药名', trigger: 'blur' }\n        ],\n        price: [\n          { required: true, message: '请输入价格', trigger: 'blur' }\n        ]\n      },\n      hospitalList:[]\n    }\n  },\n  created() {\n    this.load(1)\n    this.load2()\n  },\n  methods: {\n    call(row) {\n      let reserveData = { ...row, status: '已叫号' };\n      this.$request.put('/drug/update', reserveData).then(res => {\n        if (res.code === '200') {\n          this.$message.success('叫号成功')\n          this.load(1)\n          this.record(row)\n        }\n      })\n    },\n    record(row) {\n      let data = {\n        userId: row.userId,\n        doctorId: row.doctorId,\n      }\n      this.$request.post('/record/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('数据同步成功')\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    del(id) {\n      this.$confirm('您确定取消挂号吗？这个医生不好挂哦！', '灵魂拷问', {type: \"warning\"}).then(response => {\n        this.$request.delete('/drug/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功')\n            this.load(1)\n          } else {\n            this.$message.error(res.msg)\n          }\n        })\n      }).catch(() => {})\n    },\n    handleEdit(row) {   // 编辑数据\n      this.form = JSON.parse(JSON.stringify(row))  // 给form对象赋值  注意要深拷贝数据\n      this.formVisible = true   // 打开弹窗\n    },\n    save() {\n      this.$request.post('/drug/add', this.form).then(res => {\n        if (res.code === '200') {\n          this.$message.success('保存成功')\n          this.load(1)\n          this.formVisible = false\n        } else {\n          this.$message.error(res.msg)\n        }\n      })\n    },\n    handleAdd() {\n      this.form = {\n        hospitalId: this.user.hospitalId,\n        drugNumber: '',\n        drugName: '',\n        price: ''\n      }\n      this.formVisible = true\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum\n      this.$request.get('/drug/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status,\n          hospitalId:this.user.hospitalId\n        }\n      }).then(res => {\n        this.tableData = res.data?.list\n        this.total = res.data?.total\n      })\n    },\n    load2(){\n      this.$request.get('/hospital/selectAll').then(res=>{\n        this.hospitalList=res.data\n      })\n    },\n    reset() {\n      this.status = null\n      this.load(1)\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum)\n    },\n  }\n}\n</script>\n\n<style scoped>\n\n</style>\n"],"mappings":"AA4DA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,MAAA;MACAC,WAAA;MACAC,IAAA;QACAC,UAAA;QACAC,UAAA;QACAC,QAAA;QACAC,KAAA;MACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,KAAA;QACAR,UAAA,GACA;UAAAS,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAV,QAAA,GACA;UAAAQ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAT,KAAA,GACA;UAAAO,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;IACA,KAAAC,KAAA;EACA;EACAC,OAAA;IACAC,KAAAC,GAAA;MACA,IAAAC,WAAA;QAAA,GAAAD,GAAA;QAAAtB,MAAA;MAAA;MACA,KAAAwB,QAAA,CAAAC,GAAA,iBAAAF,WAAA,EAAAG,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAZ,IAAA;UACA,KAAAa,MAAA,CAAAT,GAAA;QACA;MACA;IACA;IACAS,OAAAT,GAAA;MACA,IAAA3B,IAAA;QACAqC,MAAA,EAAAV,GAAA,CAAAU,MAAA;QACAC,QAAA,EAAAX,GAAA,CAAAW;MACA;MACA,KAAAT,QAAA,CAAAU,IAAA,gBAAAvC,IAAA,EAAA+B,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;QACA;UACA,KAAAD,QAAA,CAAAM,KAAA,CAAAR,GAAA,CAAAS,GAAA;QACA;MACA;IACA;IACAC,IAAAC,EAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAd,IAAA,CAAAe,QAAA;QACA,KAAAjB,QAAA,CAAAkB,MAAA,mBAAAJ,EAAA,EAAAZ,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAZ,IAAA;UACA;YACA,KAAAW,QAAA,CAAAM,KAAA,CAAAR,GAAA,CAAAS,GAAA;UACA;QACA;MACA,GAAAO,KAAA;IACA;IACAC,WAAAtB,GAAA;MAAA;MACA,KAAApB,IAAA,GAAAM,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAqC,SAAA,CAAAvB,GAAA;MACA,KAAArB,WAAA;IACA;IACA6C,KAAA;MACA,KAAAtB,QAAA,CAAAU,IAAA,mBAAAhC,IAAA,EAAAwB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAZ,IAAA;UACA,KAAAjB,WAAA;QACA;UACA,KAAA4B,QAAA,CAAAM,KAAA,CAAAR,GAAA,CAAAS,GAAA;QACA;MACA;IACA;IACAW,UAAA;MACA,KAAA7C,IAAA;QACAC,UAAA,OAAAI,IAAA,CAAAJ,UAAA;QACAC,UAAA;QACAC,QAAA;QACAC,KAAA;MACA;MACA,KAAAL,WAAA;IACA;IACAiB,KAAArB,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAA2B,QAAA,CAAAwB,GAAA;QACAC,MAAA;UACApD,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,MAAA,OAAA