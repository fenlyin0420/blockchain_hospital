<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.NurseMapper">
    <insert id="insert" parameterType="com.example.entity.Nurse" useGeneratedKeys="true">
        insert into nurse
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="name != null">name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="avatar != null">avatar,</if>
            <if test="role != null">role,</if>
            <if test="description != null">description,</if>
            <if test="time != null">time,</if>
            <if test="position != null">position,</if>
            <if test="departmentId != null">department_id,</if>
            <if test="hospitalId != null">hospital_id,</if>
            <if test="publicKey != null">public_key,</if>
            <if test="privateKey != null">private_key,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="username != null">#{username},</if>
            <if test="password != null">#{password},</if>
            <if test="name != null">#{name},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="role != null">#{role},</if>
            <if test="description != null">#{description},</if>
            <if test="price != null">#{price},</if>
            <if test="time != null">#{time},</if>
            <if test="position != null">#{position},</if>
            <if test="departmentId != null">#{departmentId},</if>
            <if test="hospitalId != null">#{hospitalId},</if>
            <if test="publicKey != null">#{publicKey},</if>
            <if test="privateKey != null">#{privateKey},</if>
        </trim>
    </insert>

    <select id="findBySearch" resultType="com.example.entity.Nurse">
        select * from nurse
        <where>
            <if test="params != null and params.username != null and params.username != ''">
                and username like concat('%', #{params.username}, '%')
            </if>
            <if test="params != null and params.name != null and params.name != ''">
                and name like concat('%', #{params.name}, '%')
            </if>
        </where>
    </select>

    <select id="selectById" resultType="com.example.entity.Nurse">
        select * from nurse where id = #{id}
    </select>


</mapper>