<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.TraverseMapper">
    <resultMap id="TraverseDTOMap" type="com.example.dto.TraverseDTO">
        <!-- 映射 TraverseDTO 的其他字段 -->
        <result property="signPubKey" column="sign_pub_key"/>
        <result property="signData" column="sign_data"/>
        <result property="privateKey" column="private_key"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="age" column="age"/>
        <result property="sex" column="sex"/>
        <result property="idCard" column="id_card"/>
        <result property="occupation" column="occupation"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="hospitalName" column="hospital_name"/>
        <result property="bedName" column="bed_name"/>
        <result property="wardName" column="ward_name"/>
        <!-- 嵌套映射 Traverse 对象 -->
        <association property="traverse" javaType="Traverse">
            <id property="id" column="id"/>
            <result property="userId" column="user_id"/>
            <result property="doctorId" column="doctor_id"/>
            <result property="hospitalId" column="hospital_id"/>
            <result property="mainDiagnosis" column="main_diagnosis"/>
            <result property="secondaryDiagnosis" column="secondary_diagnosis"/>
            <result property="drug" column="drug"/>
            <result property="inHospital" column="in_hospital"/>
            <result property="careStatus" column="care_status"/>
            <result property="bedId" column="bed_id"/>
            <result property="timestamp" column="timestamp"/>
            <result property="treatmentDate" column="treatment_date"/>
            <result property="recordDate" column="record_date"/>
            <result property="img" column="img"/>
            <result property="illnessDetail" column="illness_detail"/>
            <result property="furtherCheck" column="further_check"/>
            <result property="nonMedicine" column="non_medicine"/>
            <result property="care" column="care"/>
            <result property="diet" column="diet"/>
        </association>
    </resultMap>
    <insert id="add" parameterType="com.example.entity.Traverse" useGeneratedKeys="true">
        insert into traverse
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="treatmentDate != null">treatment_date,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="userId != null">user_id,</if>
            <if test="doctorId != null">doctor_id,</if>
            <if test="hospitalId != null">hospital_id,</if>
            <if test="timestamp != null">timestamp,</if>
            <if test="mainDiagnosis != null">main_diagnosis,</if>
            <if test="secondaryDiagnosis != null">secondary_diagnosis,</if>
            <if test="drug != null">drug,</if>
            <if test="inHospital != null">in_hospital,</if>
            <if test="img != null">img,</if>
            <if test="careStatus != null">care_status,</if>
            <if test="illnessDetail != null">illness_detail,</if>
            <if test="furtherCheck != null">further_check,</if>
            <if test="nonMedicine != null">non_medicine,</if>
            <if test="care != null">care,</if>
            <if test="diet != null">diet,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="treatmentDate != null">#{treatmentDate},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="userId != null">#{userId},</if>
            <if test="doctorId != null">#{doctorId},</if>
            <if test="hospitalId != null">#{hospitalId},</if>
            <if test="timestamp != null">#{timestamp},</if>
            <if test="mainDiagnosis != null">#{mainDiagnosis},</if>
            <if test="secondaryDiagnosis != null">#{secondaryDiagnosis},</if>
            <if test="drug != null">#{drug},</if>
            <if test="inHospital != null">#{inHospital},</if>
            <if test="img != null">#{img},</if>
            <if test="careStatus != null">#{careStatus},</if>
            <if test="illnessDetail != null">#{illnessDetail},</if>
            <if test="furtherCheck != null">#{furtherCheck},</if>
            <if test="nonMedicine != null">#{nonMedicine},</if>
            <if test="care != null">#{care},</if>
            <if test="diet != null">#{diet},</if>
        </trim>
    </insert>
    
    <update id="updateById">
        update traverse
        <set>
            <if test="userId!=null">
                user_id = #{userId},
            </if>
            <if test="doctorId!=null">
                doctor_id = #{doctorId},
            </if>
            <if test="hospitalId!=null">
                hospital_id = #{hospitalId},
            </if>
            <if test="advice!=null">
                advice = #{advice},
            </if>
            <if test="drug!=null">
                drug = #{drug},
            </if>
            <if test="timestamp!=null">
                timestamp = #{timestamp},
            </if>
            <if test="signData!=null">
                sign_data = #{signData},
            </if>
            <if test="signResult!=null">
                sign_result = #{signResult},
            </if>
            <if test="signPubKey!=null">
                sign_pub_key = #{signPubKey},
            </if>
            <if test="signKey!=null">
                sign_key = #{signKey},
            </if>
            <if test="illnessDetail!=null">
                illness_detail = #{illnessDetail},
            </if>
        </set>
        where id = #{id}
    </update>

    <update id="setSignData">
        update traverse
        <set>
            sign_data = #{signData},
            sign_pub_key = #{signPubKey},
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from traverse where id = #{id}
    </delete>

    <select id="selectAll" resultType="com.example.dto.TraverseDTO" resultMap="TraverseDTOMap">
        select * from traverse_dto
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="doctorId!= null">and doctor_id = #{doctorId}</if>
            <if test="hospitalId!= null">and hospital_id = #{hospitalId}</if>
            <if test="bedId != null"> and bed_id = #{bed}</if>
            <if test="drug!= null">and drug like concat('%', #{drug}, '%')</if>
            <if test="inHospital != null">and in_hospital = #{inHospital}</if>
        </where>
        order by id
    </select>
    
    <select id="selectByTimestamp" resultType="com.example.entity.Traverse">
        select * from traverse where timestamp=#{timestamp}
    </select>
    
    <select id="selectById" resultType="com.example.entity.Traverse">
        select * from traverse where id=#{id}
    </select>

    <select id="selectByCanSend" resultType="com.example.entity.Traverse">
        select * from traverse 
        left join referal_record on traverse.doctor_id = referal_record.out_doctor_id
        where result = "待审核" and doctor_id = #{id}
    </select>

    <select id="selectLastInsertId" resultType="java.lang.Integer">
        select last_insert_id()
    </select>

    <select id="selectAlReferralTraverse" resultType="com.example.entity.ReferralTraverse">
        select * from referral_traverse
    </select>

<insert id="insertReferralTraverse" parameterType="com.example.entity.ReferralTraverse" useGeneratedKeys="true">
    insert into referral_traverse
    <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="idCard!= null">id_card,</if>
        <if test="timestamp!= null">timestamp,</if>
        <if test="treatmentDate!= null">treatment_date,</if>
        <if test="userName!= null">user_name,</if>
        <if test="doctorName!= null">doctor_name,</if>
        <if test="hospitalName!= null">hospital_name,</if>
        <if test="img!= null">img,</if>
        <if test="diagnosis!= null">diagnosis,</if>
        <if test="advice!= null">advice,</if>
        <if test="drug!= null">drug,</if>
        <if test="inHospital!= null">in_hospital,</if>
        <if test="careStatus!= null">care_status,</if>
        <if test="referralReason!= null">referral_reason,</if>
        <if test="signKey!= null">sign_key,</if>
        <if test="signResult!= null">sign_result,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
        <if test="idCard!= null">#{idCard},</if>
        <if test="timestamp!= null">#{timestamp},</if>
        <if test="treatmentDate!= null">#{treatmentDate},</if>
        <if test="userName!= null">#{userName},</if>
        <if test="doctorName!= null">#{doctorName},</if>
        <if test="hospitalName!= null">#{hospitalName},</if>
        <if test="img!= null">#{img},</if>
        <if test="diagnosis!= null">#{diagnosis},</if>
        <if test="advice!= null">#{advice},</if>
        <if test="drug!= null">#{drug},</if>
        <if test="inHospital!= null">#{inHospital},</if>
        <if test="careStatus!= null">#{careStatus},</if>
        <if test="referralReason!= null">#{referralReason},</if>
        <if test="signKey!= null">#{signKey},</if>
        <if test="signResult!= null">#{signResult},</if>
    </trim>
</insert>
</mapper>