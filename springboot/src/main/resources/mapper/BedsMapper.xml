<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.mapper.BedsMapper">
    <update id="updateById" parameterType="com.example.entity.Traverse">
        update traverse
        <set>
            <if test="bedId != null">
                bed_id = #{bedId},
            </if>
            in_hospital = #{inHospital},
            <if test="careStatus != null">
                care_status = #{careStatus},
            </if>
        </set>
        where id = #{id}
    </update>

    <update id="updateBedById" parameterType="com.example.entity.Bed">
        update bed
        <set>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="selectAllTraverse" resultType="com.example.entity.Traverse">
        select traverse.*, doctor.name as doctorName,user.name as userName
        from traverse
        left join bed on traverse.bed_id = bed.id
        left join doctor on traverse.doctor_id = doctor.id
        left join user on traverse.user_id = user.id
        <where>
            <if test="inHospital == null">and in_hospital in ('已住院','待住院')</if>
            <if test="hospitalId != null">and traverse.hospital_id= #{hospitalId}</if>
        </where>
    </select>

    <select id="selectBedPage" resultType="com.example.entity.Bed">
        select bed.*,ward.name as wardName,ward.img as wardImg
        from bed
        left join ward on bed.ward_id = ward.id
        <where>
            <if test="wardName != null">and ward.name=#{wardName}</if>
        </where>
    </select>

    <select id="selectBedAll" resultType="com.example.entity.Bed">
        select bed.*,ward.name as wardName
        from bed
        left join ward on bed.ward_id = ward.id
    </select>

