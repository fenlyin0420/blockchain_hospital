<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.mapper.CareMapper">
    <resultMap id="TraverseDTOMap" type="com.example.dto.TraverseDTO">
        <!-- 映射 TraverseDTO 的其他字段 -->
        <result property="signPubKey" column="sign_pub_key"/>
        <result property="signData" column="sign_data"/>
        <result property="publicKey" column="public_key"/>
        <result property="privateKey" column="private_key"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="age" column="age"/>
        <result property="sex" column="sex"/>
        <result property="idCard" column="id_card"/>
        <result property="occupation" column="occupation"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="hospitalName" column="hospital_name"/>
        <result property="bedName" column="bed_name"/>
        <result property="wardName" column="wardName"/>
        <!-- 嵌套映射 Traverse 对象 -->
        <association property="traverse" javaType="Traverse">
            <id property="id" column="id"/>
            <result property="userId" column="user_id"/>
            <result property="doctorId" column="doctor_id"/>
            <result property="hospitalId" column="hospital_id"/>
            <result property="mainDiagnosis" column="main_diagnosis"/>
            <result property="secondaryDiagnosis" column="secondary_diagnosis"/>
            <result property="drug" column="drug"/>
            <result property="inHospital" column="in_hospital"/>
            <result property="careStatus" column="care_status"/>
            <result property="bedId" column="bed_id"/>
            <result property="timestamp" column="timestamp"/>
            <result property="treatmentDate" column="treatment_date"/>
            <result property="recordDate" column="record_date"/>
            <result property="img" column="img"/>
            <result property="illnessDetail" column="illness_detail"/>
            <result property="furtherCheck" column="further_check"/>
            <result property="nonMedicine" column="non_medicine"/>
            <result property="care" column="care"/>
            <result property="diet" column="diet"/>
        </association>
    </resultMap>
    <update id="updateById" parameterType="com.example.entity.Traverse">
        update traverse
        <set>
            <if test="careStatus != null">
                care_status = #{careStatus},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="SearchByHId" resultType="com.example.entity.Traverse">
        select traverse.*, 
        doctor.name as doctorName,
        bed.bed_name as bedName,
        ward.name as wardName,
        user.name as userName
        from traverse
        left join bed on traverse.bed_id = bed.id
        left join doctor on traverse.doctor_id = doctor.id
        left join user on traverse.user_id = user.id
        left join ward on bed.ward_id = ward.id
        <where>
            <if test="careStatus != null">and care_status in ('未护理','已护理')</if>
            <if test="hospitalId != null">and traverse.hospital_id = #{hospitalId}</if>
        </where>
    </select>

    <select id="selectPage" resultType="com.example.dto.TraverseDTO" resultMap="TraverseDTOMap">
        select * from traverse_dto
        <where>
            <if test="careStatus == null">and care_status in ('未护理')</if>
            <if test="hospitalId!= null">and hospital_id = #{hospitalId}</if>
        </where>
    </select>

    <select id="selectPageRecord" resultType="com.example.dto.TraverseDTO" resultMap="TraverseDTOMap">
        select traverse_dto.* ,ward.name as wardName
        from traverse_dto
        left join bed on traverse_dto.bed_id = bed.id
        left join ward on bed.ward_id = ward.id
        <where>
            <if test="inHospital == null">and in_hospital = '已住院'</if>
            <if test="hospitalId!= null">and hospital_id = #{hospitalId}</if>
        </where>
    </select>
</mapper>